# Copy to .env.local for local development, and add the same values in your host's environment settings.
# Your Sanity project ID (sanity.io/manage → your project). Until it is set, the site shows its built-in placeholders.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# The site's public address, used for canonical links, the sitemap, and social previews.
NEXT_PUBLIC_SITE_URL=
# Server-only (never NEXT_PUBLIC_). A long random string shared with the Sanity publish webhook; see the README. Not needed for local dev.
SANITY_REVALIDATE_SECRET=
